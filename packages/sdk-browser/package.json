{
  "name": "@prodscope/sdk-browser",
  "version": "0.1.1",
  "description": "ProdScope browser SDK — auto-track functions, clicks, fetches, and errors with file:line mapping",
  "license": "UNLICENSED",
  "homepage": "https://prodscope.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryaamin/prodscope.git",
    "directory": "packages/sdk-browser"
  },
  "keywords": [
    "observability",
    "telemetry",
    "monitoring",
    "vite",
    "production",
    "error-tracking"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite-plugin.js",
      "types": "./dist/vite-plugin.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vite": "^6.0.0"
  }
}
