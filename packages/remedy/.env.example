# Shared with collector
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=prodscope
POSTGRES_URL=postgresql://prodscope:prodscope@localhost:5450/prodscope
ANTHROPIC_API_KEY=

# Remedy-specific
REMEDY_POLL_INTERVAL_MS=60000
REMEDY_ERROR_THRESHOLD=5
REMEDY_ERROR_WINDOW_HOURS=1
REMEDY_COOLDOWN_HOURS=24
REMEDY_WORKTREE_ROOT=/var/lib/remedy/worktrees
REMEDY_AGENT_TURN_LIMIT=25
REMEDY_AGENT_TIMEOUT_MS=900000

# GitHub (PAT for v1; swap for GitHub App later)
GITHUB_TOKEN=
GITHUB_AUTHOR_NAME=remedy-bot
GITHUB_AUTHOR_EMAIL=remedy@prodscope.dev

# Slack (optional, per-project override in DB)
SLACK_WEBHOOK_URL=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=remedy@prodscope.dev
