{
  "name": "prodscope-vscode",
  "displayName": "ProdScope",
  "description": "Live production observability inside VS Code — CodeLens, gutter decorations, and AI insights mapped to your code",
  "version": "0.1.1",
  "publisher": "prodscope",
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prodscope/prodscope",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://prodscope.dev",
  "categories": [
    "Other",
    "Debuggers",
    "Testing"
  ],
  "keywords": [
    "observability",
    "telemetry",
    "production",
    "monitoring",
    "errors"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prodscope.connect",
        "title": "ProdScope: Connect"
      },
      {
        "command": "prodscope.disconnect",
        "title": "ProdScope: Disconnect"
      },
      {
        "command": "prodscope.refreshInsight",
        "title": "ProdScope: Refresh AI Insight"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prodscope",
          "title": "ProdScope",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "prodscope": [
        {
          "type": "webview",
          "id": "prodscope.insight",
          "name": "AI Insight"
        }
      ]
    }
  },
  "icon": "icon.png",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --minify",
    "dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --watch",
    "package": "npm run build && vsce package",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  }
}
